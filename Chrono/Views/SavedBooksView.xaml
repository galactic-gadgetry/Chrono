<UserControl x:Class="Chrono.Views.SavedBooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.Views"
             xmlns:card="clr-namespace:Chrono.UIComponents.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1500"
             d:Background="White">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- #Title -->
        <Border Grid.Row="0" Margin="40,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    Content="Open"
                    Style="{StaticResource ViewTitleLabelStyle}"/>

                <Button
                    Grid.Column="1"
                    Margin="0"
                    Command="{Binding BackButtonClickedCommand}">
                    <Button.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ControlBackgroundFillColorBrush2}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>
                    <Image Source="{StaticResource ArrowLeftCircleBlack}"/>
                </Button>
            </Grid>
        </Border>

        <!-- #Content -->
        <Border
            Grid.Row="1"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Padding="40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" MaxWidth="565"/>
                    <ColumnDefinition Width="*" MinWidth="150" MaxWidth="225"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Column="0" Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="15,10,0,10">
                    <Image Source="{StaticResource BookBlack}" Height="18"/>
                    <Label Content="Name"/>
                </StackPanel>
                
                <Label
                    Grid.Column="1" Grid.Row="0"
                    Content="Date modified"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ListView
                    Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                    x:Name="SavedBooksListView"
                    ItemsSource="{Binding SavedBooks}"
                    BorderBrush="{StaticResource BorderBrushPrimary1}" BorderThickness="0,1,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <card:SavedBookCard
                                NameText="{Binding Name}"
                                StatusText="{Binding Status}"
                                DateModifiedText="{Binding DateTimeSaved}"
                                Tag="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, UpdateSourceTrigger=PropertyChanged}"
                                DeleteButtonClickedCommand="{Binding DataContext.SavedBookCardDeleteButtonClickedCommand, ElementName=SavedBooksListView}"
                                DeleteButtonClickedCommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"
                                LoadButtonClickedCommand="{Binding DataContext.SavedBookCardLoadButtonClickedCommand, ElementName=SavedBooksListView}"
                                LoadButtonClickedCommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <!-- #No Saved Books Message -->
                <Border
                    Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                    Margin="0,15">
                    <Label
                        Content="There doesn't seem to be anything here."
                        HorizontalAlignment="Center"
                        Visibility="{Binding NoSavedBooks, Converter={StaticResource BoolToVis}}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
    
</UserControl>
