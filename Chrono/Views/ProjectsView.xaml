<UserControl x:Class="Chrono.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.Views"
             xmlns:card="clr-namespace:Chrono.UIComponents.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1500"
             d:Background="White">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- #Title -->
        <Border Grid.Row="0" Margin="40,25">
            <Label Content="Projects" Style="{StaticResource ViewTitleLabelStyle}"/>
        </Border>
        
        <!-- #Content -->
        <Border
            Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- #Info -->
                <Border Grid.Row="0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- TODO: Add filters -->

                        <Button
                            Grid.Column="1"
                            Content="New Project"
                            Width="90"
                            Margin="15,0"
                            Command="{Binding NewProjectButtonClickedCommand}"/>
                    </Grid>
                </Border>
                
                <!-- #Projects List -->
                <Border
                    Grid.Row="1"
                    Padding="40,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition Width="*" MinWidth="65"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="Name"/>
                                <Label Grid.Column="1" Content="Code"/>
                                <Label Grid.Column="2" Content="WBS"/>
                                <Label Grid.Column="3" Content="Status"/>
                                <Label Grid.Column="4" Content="Actions"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" VerticalAlignment="Top">
                            <ListView
                                x:Name="ProjectsListView"
                                ItemsSource="{Binding Projects}"
                                SelectedItem="{Binding SelectedProject}"
                                BorderBrush="{StaticResource BorderBrushPrimary1}" BorderThickness="0,1,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <card:ProjectListCard
                                            CodeText="{Binding Code}"
                                            NameText="{Binding Name}"
                                            StatusText="{Binding StatusString}"
                                            WbsText="{Binding Wbs}"
                                            Tag="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListViewItem}, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        
                        <!-- #No Projects Message -->
                        <Border
                            Grid.Row="1"
                            Margin="0,15">
                            <Label
                                Content="There doesn't seem to be anything here."
                                HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- #Project Details Content -->
                <Border
                    Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                    Padding="5,15"
                    BorderBrush="{StaticResource BorderBrushPrimary1}" BorderThickness="1,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            VerticalAlignment="Top"
                            BorderBrush="{StaticResource BorderBrushPrimary1}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Label
                                    Content="Projects"
                                    FontSize="16" FontWeight="DemiBold"/>

                                <Label Content="{Binding ActiveProjectsCountString}"/>

                                <Label Content="{Binding ArchivedProjectsCountString}"/>
                            </StackPanel>
                        </Border>

                        <!-- #Project Details -->
                        <Border
                            Grid.Row="1"
                            Margin="0,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SelectedItem, ElementName=ProjectsListView}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Label
                                    Content="{Binding SelectedProject.Name}"
                                    FontSize="14"/>

                                <Label Content="{Binding SelectedProjectCreatedDateString}"/>

                                <Label Content="{Binding SelectedProject.StatusString}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Right">
                                    <StackPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource StandardControlButtonStyle}"/>
                                    </StackPanel.Resources>
                                    
                                    <Button Content="Details"/>

                                    <Button Content="Edit"/>

                                    <Button Content="Archive"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    
</UserControl>
