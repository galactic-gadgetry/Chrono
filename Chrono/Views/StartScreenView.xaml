<UserControl x:Class="Chrono.Views.StartScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.Views"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="2000"
             d:Background="White">

    <Grid x:Name="ViewGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- #Welcome Message -->
        <Border
            Grid.Row="0"
            Margin="40,25"
            BorderBrush="{StaticResource BorderBrushPrimary1}" BorderThickness="0,0,0,1">
            <Label
                Content="{Binding WelcomeMessageText}"
                Style="{StaticResource ViewTitleLabelStyle}"/>
        </Border>
        
        <Border
            Grid.Row="1"
            Width="{Binding ElementName=ViewGrid, Path=ActualWidth}"
            MinWidth="700" MaxWidth="1800"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Padding="40,0">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Controls -->
                <Border
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0" Padding="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                    <Setter Property="Width" Value="200"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="Padding" Value="25,7"/>
                                </Style>
                            </StackPanel.Resources>

                            <Button
                                Content="Create New Log Book"
                                Command="{Binding CreateNewLogBookButtonClickedCommand}"/>
                            <Button
                                Content="Open existing Log Book"
                                Command="{Binding OpenExistingLogBookButtonClickedCommand}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="30,0" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="25,7"/>
                                </Style>
                            </StackPanel.Resources>

                            <Label Content="Welcome to Chrono!"/>
                            <Label Content="A simple time logging application."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- #Separator Border -->
                <Border
                    Grid.Row="0"
                    BorderBrush="LightGray" BorderThickness="0,0,0,1"/>

                <!-- #Saved Books -->
                <Border Grid.Row="1" Margin="0,15">
                    <StackPanel>
                        <Label
                            Content="Recent"
                            HorizontalAlignment="Left"
                            FontSize="14" FontWeight="Bold"/>
                        <Label
                            Content="There doesn't seem to be anything here."
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
