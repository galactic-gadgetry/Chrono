<UserControl x:Class="Chrono.Views.CreateNewProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.Views"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1500"
             d:Background="White">
    
    <Grid>
        <Border Style="{StaticResource CenterViewBorderStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Title -->
                <Border Grid.Row="0">
                    <Label
                        Content="Create New Project"
                        Style="{StaticResource ViewTitleLabelStyle}"/>
                </Border>
                
                <!-- #Content -->
                <Border Grid.Row="1" Style="{StaticResource CenterViewContentsBorderStyle}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </StackPanel.Resources>
                        
                        <StackPanel>
                            <Label
                                Content="Name"
                                Style="{StaticResource InputFieldLabelStyle}"/>
                            <TextBox
                                Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputFieldTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel>
                            <Label
                                Content="Code"
                                Style="{StaticResource InputFieldLabelStyle}"/>
                            <TextBox
                                Text="{Binding CodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputFieldTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel>
                            <Label
                                Content="WBS"
                                Style="{StaticResource InputFieldLabelStyle}"/>
                            <TextBox
                                Text="{Binding WbsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource InputFieldTextBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- #Controls -->
                <Border Grid.Row="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource StandardControlButtonStyle}"/>
                        </StackPanel.Resources>

                        <Button
                            Content="Create"
                            Command="{Binding CreateButtonClickedCommand}"
                            IsEnabled="{Binding CanCreateProject}"
                            IsDefault="True"/>
                        <Button
                            Content="Cancel"
                            Command="{Binding CancelButtonClickedCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
