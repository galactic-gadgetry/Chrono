<UserControl x:Class="Chrono.UIComponents.Buttons.NavigationBarButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.UIComponents.Buttons"
             mc:Ignorable="d" 
             d:DesignWidth="250">
    
    <Grid>
        <Border>

            <Button Command="{Binding ButtonClickedCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource NavigationBarButtonStyle}"/>
                </Button.Resources>

                <StackPanel Orientation="Horizontal">
                    <Image
                        Source="{Binding ButtonImageSource, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                        Height="16"/>

                    <TextBlock
                        Text="{Binding ButtonText, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                        Style="{StaticResource NavigationBarButtonTextBlockStyle}"/>
                </StackPanel>
            </Button>
            
        </Border>        
    </Grid>
    
</UserControl>
