<UserControl x:Class="Chrono.UIComponents.Cards.ProjectListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.UIComponents.Cards"
             mc:Ignorable="d" d:Background="White">
    
    <Grid>
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPrimary1}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <!-- #Mouse over behavior -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundFillColorBrush2}"/>
                        </Trigger>
                        <!-- #Selected behavior -->
                        <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundFillColorBrush2}"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.Resources>
                    <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="*" MinWidth="65"/>
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="0"
                    Content="Test Project"/>

                <Label
                    Grid.Column="1"
                    Content="TEST"/>

                <Label
                    Grid.Column="2"
                    Content="12345.67.89.10.11"/>

                <Label
                    Grid.Column="3"
                    Content="Active"/>

                <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButtonStyle}"/>

                        <Style TargetType="Image">
                            <Setter Property="Height" Value="18"/>
                        </Style>
                    </StackPanel.Resources>

                    <Button>
                        <Image Source="{StaticResource Edit3Black}"/>
                    </Button>

                    <Button>
                        <Image Source="{StaticResource TrashBlack}"/>
                    </Button>
                    
                </StackPanel>
            </Grid>
            
        </Border>
    </Grid>
    
</UserControl>
