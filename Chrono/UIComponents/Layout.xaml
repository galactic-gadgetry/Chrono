<UserControl x:Class="Chrono.UIComponents.Layout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chrono.UIComponents"
             xmlns:vm="clr-namespace:Chrono.ViewModels"
             xmlns:view="clr-namespace:Chrono.Views"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1500">
    
    <Grid>
        <Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- #Nav Bar -->
                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                    <ContentControl Content="{Binding CurrentNavigationBarViewModel}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:NavigationBarViewModel}">
                                <local:NavigationBar/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
                
                
                <!-- #Content -->
                <Border Grid.Column="1" Grid.Row="0">
                    <ContentControl Content="{Binding CurrentContentViewModel}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:BookDetailsViewModel}">
                                <view:BookDetailsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:CreateNewBookViewModel}">
                                <view:CreateNewBookView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:EditBookDetailsViewModel}">
                                <view:EditBookDetailsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                                <view:ProjectsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SavedBooksViewModel}">
                                <view:SavedBooksView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
                
                <!-- #Info Bar -->
                <Border Grid.Column="1" Grid.Row="1">
                    <Label Content="{Binding InfoText}"/>
                </Border>
            </Grid>

        </Border>
    </Grid>
    
</UserControl>
